<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Varve hub als LaunchAgent (macOS). Sjabloon: `varve-hub installeer` vult de paden in en schrijft
     ~/Library/LaunchAgents/nl.varve.hub.plist. Niet met de hand kopiëren; zie docs/NETWERK.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.varve.hub</string>
  <key>ProgramArguments</key>
  <array>
    {{ARGUMENTEN}}
  </array>
  <key>WorkingDirectory</key>
  <string>{{HUB}}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
</dict>
</plist>
