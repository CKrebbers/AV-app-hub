+    "pads": {"preset1": 36, "preset2": 37, "preset3": 38, "preset4": 39, "record": 40, "takelog": 41, "paniek": 42},
     "energy": {"channel": 2, "note": 48, "thresh": 0.35}
   },
   "knobs": {
diff --git a/td/_mock_td_test.py b/td/_mock_td_test.py
index e219857..a07ddf1 100644
--- a/td/_mock_td_test.py
+++ b/td/_mock_td_test.py
@@ -417,7 +417,7 @@ def run():
     rec = hub.op('rec')
     check(rec.par.uniquesuff.val is True and rec.par.videocodec.val == 'prores', 'rec: uniquesuff aan, codec prores')
     mi = hub.op('midi_in')
-    check(mi.par.controlind.val == '20 21 22 23 24 25 26 27' and mi.par.notescope.val == '36 37 38 39 40 41'
+    check(mi.par.controlind.val == '20 21 22 23 24 25 26 27' and mi.par.notescope.val == '36 37 38 39 40 41 42'
           and mi.par.norm.val == 'off' and mi.par.notenorm.val == '0to1' and mi.par.id.val == 1,
           'midi_in: controlind/notescope/norm/id')
     check(hub.op('midi_logic').par.id.val == 3 and hub.op('midi_out').par.id.val == 2, 'device-ids L2TD 3 / TD2L 2')
@@ -518,6 +518,34 @@ def run():
     pads.onOffToOn(Chan('ch1n36', 1), 0, 1, 0)
     check(hub.fetch('preset') == 1 and hub.op('pickup_mask')['knob1'].eval() == 0, 'pad 36 → preset 1, pickup reset')
 
+    # paniek (pad 42, varve-hub LPD8-P1): master (knob8) op 0, los van de pickup; andere knoppen blijven.
+    # Terug met een preset of met de eerstvolgende knob8-waarde (welke ook): de hub stuurt die alleen bewust.
+    base, mask, inv = hub.op('preset_base'), hub.op('pickup_mask'), hub.op('pickup_inv')
+    pick.onValueChange(Chan('knob8', 0.9), 0, 0.9, 0.0)        # eerste event van knob8: genegeerd
+    pick.onValueChange(Chan('knob8', 1.0), 0, 1.0, 0.9)        # passeert preset 1 (1.00): opgepakt
+    check(mask['knob8'].eval() == 1, 'knob8 opgepakt vóór paniek')
+    k1 = base['knob1'].eval()
+    pads.onOffToOn(Chan('ch1n42', 1), 0, 1, 0)
+    check(base['knob8'].eval() == 0 and mask['knob8'].eval() == 0 and inv['knob8'].eval() == 1
+          and hub.fetch('pickup')['knob8'] is False, 'pad 42 → paniek: knob8 vast op 0 (ctrl.knob8 = 0)')
+    check(base['knob1'].eval() == k1 and hub.fetch('preset') == 1, 'paniek laat andere knoppen en preset staan')
+    check(ui_status_log[-1].startswith('PANIEK'), 'paniek → status PANIEK')
+    pick.onValueChange(Chan('knob1', 0.2), 0, 0.2, 0.99)       # een andere knop heft de paniek niet op
+    check(mask['knob8'].eval() == 0, 'na paniek: andere knop laat de master dicht')
+    pick.onValueChange(Chan('knob8', 0.7), 0, 0.7, 1.0)        # nieuwe master-waarde (K2/cockpit/snapshot), geen kruising
+    check(mask['knob8'].eval() == 1 and inv['knob8'].eval() == 0, 'na paniek: eerste nieuwe knob8-waarde (0.7) neemt meteen over')
+    pick.onValueChange(Chan('knob8', 0.75), 0, 0.75, 0.7)
+    check(mask['knob8'].eval() == 1, 'daarna volgt knob8 gewoon')
+    pads.onOffToOn(Chan('ch1n42', 1), 0, 1, 0)
+    pads.apply_preset(1)
+    check(base['knob8'].eval() == 1.0, 'preset na paniek zet de master terug op de presetwaarde')
+    pick.onValueChange(Chan('knob8', 0.5), 0, 0.5, 0.75)       # na de preset weer gewone soft-takeover
+    check(mask['knob8'].eval() == 0, 'preset wist de paniek: knob8 wacht weer op de presetwaarde')
+    hub.store('knob_seen', [k for k in hub.fetch('knob_seen') if k != 'knob8'])
+    pads.onOffToOn(Chan('ch1n42', 1), 0, 1, 0)
+    pick.onValueChange(Chan('knob8', 0.4), 0, 0.4, 0.0)        # ook als knob8 nog nooit binnenkwam
+    check(mask['knob8'].eval() == 1, 'na paniek: ook een eerste knob8-event ooit neemt over')
+
     # osc/grid data (kanaalnamen slash-vrij in to_blender)
     hub.op('osc_in').vals = {'cam_g_0': 0.3, 'cam_energy': 0.5, 'cam_fps': 29.7}
     hub.op('to_blender').vals = {'knob4': 0.2, 'energy': 0.5, 'g12': 0.1, 'kick': 0.7}
@@ -609,6 +637,12 @@ def run():
     check(any(w.startswith('CONFIG') for w in g2['_warn']), 'zonder KIT_ROOT: CONFIG-melding + defaults')
     check(all(PROJECT1.op('hub').op(t).bypass for t in ('fx_sort', 'fx_palette', 'fx_shift')),
           'zonder KIT_ROOT: shaders gebypasst')
+    # paniek staat niet in de defaults: alleen config.json → midi.pads.paniek zet hem aan
+    check('paniek' not in g2['PAD_NOTES'], 'zonder config.json: geen paniek-noot (niet in _DEFAULTS)')
+    base2 = PROJECT1.op('hub').op('preset_base')
+    k8 = base2['knob8'].eval()
+    PROJECT1.op('hub').op('pads').module.onOffToOn(Chan('ch1n42', 1), 0, 1, 0)
+    check(base2['knob8'].eval() == k8, 'zonder midi.pads.paniek: noot 42 doet niets, geen fout')
 
     print(f'\n{len(fails)} fouten')
     return 1 if fails else 0
diff --git a/td/td_build_hub.py b/td/td_build_hub.py
index 77e3260..5703f80 100644
--- a/td/td_build_hub.py
+++ b/td/td_build_hub.py
@@ -775,12 +775,13 @@ try:
 except Exception as e:  # noqa: BLE001
     _warn.append(f"presets-tabel niet gevuld: {e}")
 
-# --- pads: presets (soft-takeover) / record / take-log
+# --- pads: presets (soft-takeover) / record / take-log / paniek
 pad_exec = mk(hub, chopexecDAT, 'pads', X3 + 150, 0)
 setp(pad_exec, 'notes', 'chop')
 setp(pad_exec, True, 'offtoon')
 pad_exec.text = f'''
-# Pads 1–4 = preset uit `presets`; pad record/takelog = toggles. Soft-takeover-state in hub-storage.
+# Pads 1–4 = preset uit `presets`; pad record/takelog = toggles; pad paniek (varve-hub LPD8-P1) = master dicht.
+# Soft-takeover-state in hub-storage.
 NOTES = {PAD_NOTES!r}
 CH = {MIDI_CH!r}
 KNOBS = {KNOB_NAMES!r}
@@ -788,6 +789,7 @@ FX = {{'sort': 'fx_sort', 'palette': 'fx_palette', 'shift': 'fx_shift'}}
 FX_OK = {fx_ok!r}
 FX_COLS = {FX_COLS!r}
 PICK_EPS = 0.02
+MASTER = 'knob8'   # master-dim → opacity van dim (dezelfde vaste keuze als K(8, 1) voor dim hierboven)
 ''' + '''
 import time
 
@@ -826,6 +828,7 @@ def apply_preset(i):
         c.par.operand.val = row['blend']
     hub = parent()
     hub.store('pickup', picked)
+    hub.store('paniek_open', False)
     hub.store('preset', i)
     ui.status = 'preset %d %s' % (i, row['name'])
 
@@ -834,6 +837,17 @@ def knob_moved(name, val, prev):
         return
     hub = parent()
     seen = set(hub.fetch('knob_seen', ()))
+    if name == MASTER and hub.fetch('paniek_open', False):
+        # na een paniek: de eerste nieuwe master-waarde neemt het meteen over (geen kruising nodig)
+        hub.store('paniek_open', False)
+        seen.add(name)
+        hub.store('knob_seen', sorted(seen))
+        picked = dict(hub.fetch('pickup', {}))
+        picked[name] = True
+        hub.store('pickup', picked)
+        _set_const(op('pickup_mask'), name, 1)
+        _set_const(op('pickup_inv'), name, 0)
+        return
     if name not in seen:
         # eerste event van een nieuw kanaal: prev is dan de beginwaarde (0), geen echte beweging
         seen.add(name)
@@ -850,6 +864,21 @@ def knob_moved(name, val, prev):
         _set_const(op('pickup_mask'), name, 1)
         _set_const(op('pickup_inv'), name, 0)
 
+def paniek():
+    """Master dicht, los van de pickup-stand: knob8 op 0 tot er een nieuwe master-waarde binnenkomt.
+    Zelfde mechaniek als apply_preset, maar alleen voor de master; de andere knoppen blijven staan.
+    Terug: een preset-pad, of de eerstvolgende CC van knob8 (welke waarde ook). Die komt alleen als de hub
+    bewust een nieuwe master stuurt (K2, cockpit, snapshot, de APC-fader); zo volgt TD wat de hub toont."""
+    _set_const(op('preset_base'), MASTER, 0.0)
+    _set_const(op('pickup_mask'), MASTER, 0)
+    _set_const(op('pickup_inv'), MASTER, 1)
+    hub = parent()
+    picked = dict(hub.fetch('pickup', {}))
+    picked[MASTER] = False
+    hub.store('pickup', picked)
+    hub.store('paniek_open', True)
+    ui.status = 'PANIEK: master dicht (nieuwe master-waarde of een preset)'
+
 def set_record(on):
     """Rec aan/uit; take-log start/stopt mee (tenzij die al handmatig liep). rec-start = log-t0."""
     hub = parent()
@@ -876,6 +905,8 @@ def onOffToOn(channel, sampleIndex, val, prev):
     hub = parent()
     if n == 'ch%dn%d' % (CH, NOTES['record']):
         set_record(not op('rec').par.record.eval())
+    elif 'paniek' in NOTES and n == 'ch%dn%d' % (CH, NOTES['paniek']):
+        paniek()
     elif n == 'ch%dn%d' % (CH, NOTES['takelog']):
         # optioneel handmatig; t blijft relatief aan rec-start als rec loopt
         on = not hub.fetch('takelog_on', False)
@@ -949,6 +980,7 @@ hub.store('energy_on', False)
 hub.store('takelog_on', False)
 hub.store('takelog_auto', False)
 hub.store('knob_seen', [])
+hub.store('paniek_open', False)
 hub.store('osc_sent', 0)
 print(f'hub gebouwd: {hub.path} — out = {out.path}, perform = {monitor.path}')
 print(f'latency ({ALIGN}): cam_delay {CAM_DELAY_FR} fr, blender_delay {BL_DELAY_FR} fr, '
