+      const hb = setInterval(() => { if (ws.readyState === 1) ws.send('{"t":"hb"}'); }, 500);
+      ws.on('close', () => clearInterval(hb));
+      await tot(() => echt.kern.beeld().focus === 'scene');
+    }
+    const { page } = await open(`${BASIS}?hub=${encodeURIComponent(appUrl)}`);
+    const app = () => echt.kern.beeld().apps.find((a) => a.app === 'av-kern');
+    ok('av-kern aangemeld (actief, lease), focus nog bij de andere app', await tot(() => app()?.status === 'actief' && app()?.lease && echt.kern.beeld().focus === 'scene'));
+    const slot = app().slot;
+    // De hubtoets uit de config van de hub (standaard Bank, noot 103), niet hardcoded.
+    const ht = APC.OP_ID.get(echt.kern.hubtoets);
+    if (!ht || ht.t !== 'note') throw new Error(`hubtoets ${echt.kern.hubtoets} is geen noot op de APC`);
+    const HT = ht.n, HTCH = ht.ch ?? 0;
+    const mark = apc.verstuurd.length;
+    apc.injecteer([0x90 | HTCH, HT, 127]);                    // hubtoets (Bank) vast
+    apc.injecteer([0x90 | (slot - 1), 51, 127]);              // Track Select van het slot van av-kern
+    apc.injecteer([0x80 | (slot - 1), 51, 0]);
+    apc.injecteer([0x80 | HTCH, HT, 0]);
+    ok(`Bank + Track Select ${slot} geeft av-kern de focus`, await tot(() => echt.kern.beeld().focus === 'av-kern'));
+    ok('… en av-kern weet het', await tot(() => page.evaluate(() => window.avKern.hub.status().focus)));
+    const naarApc = (pred) => apc.verstuurd.slice(mark).some(pred);
+    ok('LED-kaart van av-kern op de APC (volledige repaint)', await tot(() => apc.verstuurd.length - mark > 100), `${apc.verstuurd.length - mark} berichten`);
+    const sysex = apc.verstuurd.filter((b) => b[0] === 0xf0 && b[1] === 0x47 && b[4] === 0x60);
+    ok('alleen de hub zet de modus (0x42), av-kern nooit 0x41', sysex.length > 0 && sysex.every((b) => b[7] === 0x42), sysex.map((b) => b[7].toString(16)).join(','));
+
+    // Pad 2-1 = Drone variant 2: av-kern tekent de pad in de kleur van de Drone.
+    const m1 = apc.verstuurd.length;
+    apc.injecteer([0x90, 8, 127]); apc.injecteer([0x80, 8, 0]);
+    const kleur = await page.evaluate(() => window.avKern.bus.slots[0].col);
+    ok('pad 2-1 → av-kern (variant) → LED van pad 2-1 op de APC', await tot(() => apc.verstuurd.slice(m1).some((b) => (b[0] & 0xf0) === 0x90 && b[1] === 8 && b[2] === kleur)),
+      `variant ${await page.evaluate(() => window.avKern.bus.variant[0])}`);
+
+    // Knop tk3 (CC 50) = macro beweging: de hub tekent de ring mee (rings:"auto"), av-kern zet de macro.
+    const m2 = apc.verstuurd.length;
