+// ---- nep-tijd: timers lopen alleen als de test de tijd verzet ----
+class NepTijd implements Tijd {
+  t = 0;
+  private n = 0;
+  private rij = new Map<number, { op: number; fn: () => void }>();
+  nu() { return this.t; }
+  zet(fn: () => void, ms: number) { const id = ++this.n; this.rij.set(id, { op: this.t + ms, fn }); return id; }
+  wis(h: unknown) { this.rij.delete(h as number); }
+  verzet(ms: number) {
+    const eind = this.t + ms;
+    for (;;) {
+      let volgende: [number, { op: number; fn: () => void }] | null = null;
+      for (const e of this.rij) if (e[1].op <= eind && (!volgende || e[1].op < volgende[1].op)) volgende = e;
+      if (!volgende) break;
+      this.rij.delete(volgende[0]);
+      this.t = Math.max(this.t, volgende[1].op);
+      volgende[1].fn();
+    }
+    this.t = eind;
+  }
+}
+
+// ---- nep-WebSocket: de test speelt de hub ----
+class NepWS implements WsLike {
+  static alle: NepWS[] = [];
+  readyState = 0;
+  uit: Record<string, unknown>[] = [];
+  onopen: WsLike['onopen'] = null;
+  onmessage: WsLike['onmessage'] = null;
+  onerror: WsLike['onerror'] = null;
+  onclose: WsLike['onclose'] = null;
+  constructor(public url: string) { NepWS.alle.push(this); }
+  send(d: string) { if (this.readyState !== 1) throw new Error('niet open'); this.uit.push(JSON.parse(d)); }
+  close() { if (this.readyState === 3) return; this.readyState = 3; this.onclose?.({ code: 1000 }); }
+  // hub-kant
+  openen() { this.readyState = 1; this.onopen?.(); this.hub({ t: 'welkom', hub: 'varve-hub', v: 1 }); }
+  hub(b: object) { this.onmessage?.({ data: JSON.stringify(b) }); }
+  sluitDoorHub(code = 1006) { this.readyState = 3; this.onclose?.({ code }); }
+  van(t: string) { return this.uit.filter((b) => b.t === t); }
+}
+
+function rig() {
+  NepWS.alle = [];
+  const bus = new Bus(SLOTS, SCENES);
+  bus.loadScene(0, true);
+  const loader = new Loader(bus, createRegistry(bus), kernIds);
+  loader.bind(ADEM);
+  const driver = new Driver(loader);
+  const tijd = new NepTijd();
+  const status: string[] = [];
+  const hub = new HubKoppeling({ url: 'ws://localhost:7700/app', driver, bus, WS: NepWS, tijd, inst: 'test-1', onStatus: (_ok, t) => status.push(t) });
+  hub.start();
+  const ws = () => NepWS.alle[NepWS.alle.length - 1];
+  const loop = (sec: number) => { for (let i = 0; i < Math.round(sec / TICK); i++) bus.step(); };
+  return { bus, loader, driver, tijd, hub, ws, status, loop };
+}
