+    ok('tk3 → av-kern macro beweging', await tot(async () => Math.abs((await page.evaluate(() => window.avKern.bus.tgt('macro2'))) - 20 / 127) < 1e-6));
+    ok('… en de ring van tk3 staat op de APC', apc.verstuurd.slice(m2).some((b) => b[0] === 0xb0 && b[1] === 50 && b[2] === 20));
+
+    // LPD8 K5 = macro.kleur → av-kern macro kleur → av-kern tekent de ring van tk1 (CC 48) → APC.
+    await tot(() => echt.apparaten.lpd8.model === 'mk2');
+    const m3 = apc.verstuurd.length;
+    for (let v = 0; v <= 127; v += 4) { lpd8.injecteer([0xb0, knopCC('macro.kleur'), v]); await wacht(15); }   // door de huidige stand (pickup)
+    for (let v = 127; v >= 100; v -= 3) { lpd8.injecteer([0xb0, knopCC('macro.kleur'), v]); await wacht(15); }
+    lpd8.injecteer([0xb0, knopCC('macro.kleur'), 100]);
+    const kl = () => page.evaluate(() => window.avKern.bus.tgt('macro0'));
+    ok('LPD8 K5 (macro.kleur) → av-kern macro kleur', await tot(async () => Math.abs((await kl()) - 100 / 127) < 0.02), (await kl()).toFixed(3));
+    ok('… en av-kern tekent de ring van tk1 op de APC', await tot(() => apc.verstuurd.slice(m3).some((b) => b[0] === 0xb0 && b[1] === 48 && Math.abs(b[2] - 100) <= 2)));
+
+    // LPD8 K1 = macro.intensiteit → master.
+    for (let v = 0; v <= 127; v += 4) { lpd8.injecteer([0xb0, knopCC('macro.intensiteit'), v]); await wacht(15); }
+    for (let v = 127; v >= 64; v -= 4) { lpd8.injecteer([0xb0, knopCC('macro.intensiteit'), v]); await wacht(15); }
+    lpd8.injecteer([0xb0, knopCC('macro.intensiteit'), 64]);
+    const ms = () => page.evaluate(() => window.avKern.bus.tgt('master'));
+    ok('LPD8 K1 (macro.intensiteit) → master', await tot(async () => Math.abs((await ms()) - 64 / 127) < 0.02), (await ms()).toFixed(3));
+
+    // Een eigen wijziging gaat terug naar de hub (de app is de bron van waarheid).
+    apc.injecteer([0xb0, 50, 90]);
+    ok('eigen wijziging (tk3) → zet naar de hub', await tot(() => Math.abs((app()?.waarden.beweging ?? -1) - 90 / 127) < 1e-3), String(app()?.waarden.beweging));
+
+    // LPD8 P1 1 s vast = paniek → Stop All in av-kern.
+    lpd8.injecteer([0x99, 36, 100]);
+    ok('LPD8 P1 1 s vast (paniek) → Stop All (master → 0, langzaam)', await tot(async () => (await ms()) === 0, 4000));
+    lpd8.injecteer([0x89, 36, 0]);
+
+    // Focus terug naar de andere app (Bank + Track Select 1): de LED's van av-kern gaan van de APC af.
+    apc.injecteer([0x90 | HTCH, HT, 127]); apc.injecteer([0x90, 51, 127]); apc.injecteer([0x80, 51, 0]); apc.injecteer([0x80 | HTCH, HT, 0]);
+    ok('Bank + Track Select 1: focus terug naar de andere app', await tot(() => echt.kern.beeld().focus === 'scene' && page.evaluate(() => !window.avKern.hub.status().focus)));
+    const voor = await page.evaluate(() => window.avKern.bus.tgt('macro2'));
+    apc.injecteer([0xb0, 50, 5]);
+    await wacht(200);
+    ok('zonder focus krijgt av-kern geen APC-invoer', (await page.evaluate(() => window.avKern.bus.tgt('macro2'))) === voor);
+    const nu = await page.evaluate(() => ({ midi: window.__midi, locks: window.__locks }));
+    ok('ook hier geen requestMIDIAccess en geen Web Lock', nu.midi === 0 && nu.locks === 0);
+  } finally { for (const ws of andere) ws.close(); await echt.stop(); }
+} finally {
+  await browser.close().catch(() => {});
+  await vite.close();
+}
+console.log(fails.length ? `\n${fails.length} FOUT(EN): ${fails.join(', ')}` : '\nAlle checks groen: av-kern conform PROTOCOL.md.');
+process.exit(fails.length ? 1 : 0);
