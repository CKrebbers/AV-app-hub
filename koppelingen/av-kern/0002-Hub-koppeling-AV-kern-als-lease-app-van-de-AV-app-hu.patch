+    const ws = voor.ws.filter((u) => !u.startsWith(`ws://localhost:${POORT}/`)); // die van Vite zelf (HMR) telt niet
+    ok('geen WebSocket, hub.ts niet geladen, niets op window', ws.length === 0 && !hubGeladen(verzoeken) && !voor.avKern, ws.join(', '));
+    ok('knop "Verbind APC40" zoals altijd', voor.knop === 'Verbind APC40' && !voor.uit && voor.midi === 0);
+    await page.click('#btnMidi');
