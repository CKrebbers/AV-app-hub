+    const { page, verzoeken } = await open(`${BASIS}?hub=${encodeURIComponent(h)}`);
+    await page.click('#btnMidi', { force: true, timeout: 1000 }).catch(() => {});
+    await wacht(300);
+    const g = await page.evaluate(() => ({ midi: window.__midi, locks: window.__locks, txt: document.getElementById('midiTxt').textContent,
+      knop: document.getElementById('btnMidi').textContent, uit: document.getElementById('btnMidi').disabled }));
+    ok(`?hub=${h}: 0× MIDI, 0× lock, hub.ts niet geladen`, g.midi === 0 && g.locks === 0 && !hubGeladen(verzoeken) && g.uit, `${g.midi}× MIDI, ${g.locks}× lock`);
+    ok(`?hub=${h}: melding "${g.txt}"`, verwacht.test(g.txt));
+    await page.close();
+  }
+
+  console.log('\nmet ?hub=: de conformiteitstoets van de hub');
+  let hub = null;
+  const r = await toetsApp({ poort: 0, start: async (url) => { hub = await open(`${BASIS}?hub=${encodeURIComponent(url)}`); } });
+  for (const u of r.uitslagen) ok(`toetsApp: ${u.naam}`, u.ok, u.detail);
+  ok(`toetsApp: ${r.app} conform PROTOCOL.md`, r.ok && r.app === 'av-kern');
+  await hub.page.click('#btnMidi', { force: true, timeout: 1000 }).catch(() => {});
+  await wacht(300);
+  const h = await hub.page.evaluate(() => ({ midi: window.__midi, locks: window.__locks, s: window.avKern?.hub.status(),
+    knop: document.getElementById('btnMidi').textContent, uit: document.getElementById('btnMidi').disabled }));
+  ok('requestMIDIAccess NOOIT aangeroepen, ook niet na een klik op de knop', h.midi === 0, `${h.midi}×`);
+  ok('Web Lock av-kern-apc niet gebruikt', h.locks === 0, `${h.locks}×`);
+  ok('knop zegt "APC via hub" en doet niets', h.knop === 'APC via hub' && h.uit);
+  ok('hub.ts geladen; LED\'s naar de hub, modus-SysEx nooit', hubGeladen(hub.verzoeken) && h.s.leds > 100 && h.s.ingeslikt === 0, `${h.s.leds} LED-berichten`);
+  await hub.page.close();
+
+  console.log('\nde echte hub (startHub) met een nep-APC en een nep-LPD8');
+  const { startHub } = await import(join(HUB, 'src/hub.js'));
+  const { NepSysteem } = await import(join(HUB, 'src/ports/nep.js'));
+  const { laadConfig } = await import(join(HUB, 'src/config.js'));
+  const APC = await import(join(HUB, 'src/devices/apc40mk2.js'));
+  const { ROLLEN } = await import(join(HUB, 'src/protocol/manifest.js'));
+  /** LPD8 mk2 (fabrieksindeling): K1..K8 = CC 70..77, in de volgorde van ROLLEN (PROTOCOL.md §6). */
+  const knopCC = (rol) => 70 + ROLLEN.indexOf(rol);
+  const { default: WebSocket } = await import(join(HUB, 'node_modules/ws/index.js'));
+  const systeem = new NepSysteem();
+  const apc = systeem.voegToe('APC40 mkII');
+  const lpd8 = systeem.voegToe('LPD8 mk2');
+  lpd8.antwoord = (b) => { if (b[1] === 0x7e) setTimeout(() => lpd8.injecteer([0xf0, 0x7e, 0, 6, 2, 0x47, 0x4c, 0, 0xf7]), 1); };
+  const echt = await startHub({ config: { ...laadConfig(), hotplug_ms: 20 }, systeem, poort: 0, drivers: false });
+  const andere = [];
+  try {
+    const appUrl = echt.adres.replace('http', 'ws') + '/app';
+    // Eerst een andere app: die krijgt de focus, zodat Clay AV-kern zelf kiest (Bank + Track Select).
+    {
