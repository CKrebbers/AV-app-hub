+// De koppeling met de AV-app-hub (src/ui/hub.ts) in een echte Chromium, met de conformiteitstoets van de
+// hub zelf (AV-app-hub tools/nep-hub.mjs: toetsApp) en daarna de echte hub (startHub) met een nep-APC en
+// een nep-LPD8.
+//
+//   1. ZONDER ?hub=: alles zoals altijd. Geen WebSocket, hub.ts wordt niet geladen, en "Verbind APC40"
+//      vraagt Web MIDI (en de Web Lock av-kern-apc) zoals nu.
+//   1b. Een GEWEIGERD ?hub= (geen ws://, of een vreemde host): ook dan geen MIDI en geen Web Lock.
+//   2. MET ?hub=<nep-hub>: toetsApp moet slagen (hallo, geldig manifest, staat, hartslag, onbekende
+//      berichten, geen mode-SysEx, herverbinden). requestMIDIAccess en de Web Lock worden NOOIT gebruikt.
+//   3. De echte hub: eerst een andere app (die krijgt de focus), dan AV-kern. Bank + Track Select op de
+//      nep-APC geeft AV-kern de focus; een pad, een knop en een LPD8-macro in AV-kern komen als LED's en
+//      ringen op de nep-APC; LPD8 P1 = Stop All.
+//
+// VEILIG MET DE APC AANGESLOTEN: requestMIDIAccess is in elke pagina een spion die telt en weigert.
+//
+// Nodig: de repo AV-app-hub (voor toetsApp, startHub, ws en playwright-core uit zijn node_modules).
+// Gebruik:  node scripts/hub-headless.mjs
+//   AVKERN_HUB_REPO=<map>  de AV-app-hub (standaard ../av-app-hub naast deze repo)
+//   AVKERN_CHROME=<pad>    een eigen Chromium (standaard /opt/pw-browsers/chromium als die er is). Op de Mac:
+//                          AVKERN_CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
+//   AVKERN_KIJK_POORT      poort voor de Vite-server (standaard 5199)
+import { existsSync } from 'node:fs';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createServer } from 'vite';
+
+const WORTEL = fileURLToPath(new URL('..', import.meta.url));
+const HUB = process.env.AVKERN_HUB_REPO || join(WORTEL, '../av-app-hub');
+const POORT = Number(process.env.AVKERN_KIJK_POORT) || 5199;
+const CHROME = process.env.AVKERN_CHROME || (existsSync('/opt/pw-browsers/chromium') ? '/opt/pw-browsers/chromium' : undefined);
+if (!existsSync(join(HUB, 'tools/nep-hub.mjs'))) { console.error(`geen AV-app-hub in ${HUB} (zet AVKERN_HUB_REPO)`); process.exit(2); }
+const { toetsApp } = await import(join(HUB, 'tools/nep-hub.mjs'));
+const { chromium } = await import(join(HUB, 'node_modules/playwright-core/index.mjs'));
+
+const wacht = (ms) => new Promise((r) => setTimeout(r, ms));
+const tot = async (fn, ms = 10000) => { const eind = Date.now() + ms; while (Date.now() < eind) { const x = await fn(); if (x) return x; await wacht(50); } return fn(); };
+const fails = [];
+const ok = (naam, cond, extra = '') => { if (!cond) fails.push(naam); console.log(`${cond ? '  ok  ' : 'FAIL  '}${naam}${extra ? ` (${extra})` : ''}`); };
+
+// In elke pagina vóór alles: spionnen op Web MIDI (telt, weigert), de Web Lock (telt) en WebSocket (adressen).
+const SPIONNEN = () => {
+  window.__midi = 0;
+  window.__locks = 0;
+  window.__ws = [];
+  const weiger = () => { window.__midi++; return Promise.reject(new DOMException('geen MIDI in de test', 'SecurityError')); };
+  Object.defineProperty(Navigator.prototype, 'requestMIDIAccess', { configurable: true, value: weiger });
+  if (navigator.locks) {
+    const echt = navigator.locks.request.bind(navigator.locks);
+    navigator.locks.request = (...a) => { window.__locks++; return echt(...a); };
+  }
+  const Echt = window.WebSocket;
+  window.WebSocket = class extends Echt { constructor(url, p) { super(url, p); window.__ws.push(String(url)); } };
+};
+
+const vite = await createServer({ root: WORTEL, logLevel: 'error', server: { port: POORT, strictPort: true, open: false } });
+await vite.listen();
+const browser = await chromium.launch({ executablePath: CHROME, args: ['--use-gl=swiftshader', '--enable-unsafe-swiftshader'] });
+const context = await browser.newContext();
+await context.addInitScript(SPIONNEN);
+const BASIS = `http://localhost:${POORT}/`;
+
+async function open(url) {
+  const page = await context.newPage();
+  const verzoeken = [];
+  page.on('request', (r) => verzoeken.push(r.url()));
