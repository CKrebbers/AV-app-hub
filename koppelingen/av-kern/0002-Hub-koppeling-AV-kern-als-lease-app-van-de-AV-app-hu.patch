@@ -0,0 +1,356 @@
+// Koppeling met de AV-app-hub (repo AV-app-hub, PROTOCOL.md §5: lease). Alleen met ?hub=ws://… (hub-vlag.ts);
+// zonder vlag wordt dit bestand niet eens geladen.
+//
+// De hub is de enige die de APC40 en de LPD8 opent. Voor AV-kern is hij een vervanger van Web MIDI:
+//   invoer:  {t:'midi', dev:'apc40', bytes}  → Driver.input(bytes, 'hub')  (zelfde pad als de echte APC)
+//   uitvoer: Driver.onSend (de LED- en ringhaak)  → per beeld gebundeld → {t:'led', bytes:[…]}
+// requestMIDIAccess wordt NOOIT aangeroepen en de Web Lock `av-kern-apc` niet gebruikt (twee tabbladen regelt
+// de hub: de nieuwste wint, de oude krijgt 4001). De modus-SysEx stuurt AV-kern hier niet: de hub zet de APC in
+// 0x42 en tekent de ringen mee met de knop (`rings:"auto"`), zoals de APC zelf in 0x41 doet.
+//
+// De kern blijft onaangeroerd (regel 1). APC-invoer gaat door Driver.input en de LED's komen van Driver.onSend,
+// net als bij de echte APC in main.ts. Daarnaast parameters met een rol (hub-manifest.json), zodat de
+// LPD8-macro's iets doen: die zet dit bestand met Bus.set/tgt/stopAll DIRECT, buiten Driver.input om, dus
+// niet in het actielog (zie de LEESMIJ). Tijdens een replay (driver.enabled false) negeren we ze, behalve
+// paniek. Wat AV-kern zelf verandert, of niet overneemt, gaat terug als `zet` (de app is de bron van waarheid).
+//
+// Geen eigen klok: tijd en timers komen binnen via `Tijd` (de test geeft een nep).
+import type { Driver } from '../kern/midi';
+import type { Bus } from '../kern/bus';
+import MANIFEST_JSON from './hub-manifest.json';
+
+export const APP = 'av-kern';
+export const MANIFEST = MANIFEST_JSON;
+export const HB_S = MANIFEST.hb_s;
+/** Wachttijden bij herverbinden (PROTOCOL.md §3), en na 4001 "vervangen" (§11). */
+export const WACHT_MS = [500, 1000, 2000, 5000];
+export const VERVANGEN = 4001;
+export const VERVANGEN_MS = 30000;
+/** Pas na zo lang open telt een verbinding als gelukt (wachttijd terug naar 0,5 s). */
+export const STABIEL_MS = 3000;
+/** Een socket die na zo lang nog niet open is (onbereikbare host), sluiten we zelf. */
+export const OPEN_MS = 5000;
+/** Hartslag als er zo lang niets naar de hub ging (elk bericht telt). Plus hooguit één tik: nooit meer dan 0,8 s. */
+export const HB_MS = HB_S * 600;
+/** LED's bundelen per beeld. */
+export const BEELD_MS = 16;
+/** Eigen wijzigingen terugmelden en kijken of er een hartslag moet. */
+export const TIK_MS = 200;
+
+/** Tijd van buiten: `nu()` in ms, en timers. */
+export interface Tijd {
+  nu(): number;
+  zet(fn: () => void, ms: number): unknown;
+  wis(h: unknown): void;
+}
+export const echteTijd: Tijd = {
+  nu: () => performance.now(),
+  zet: (fn, ms) => setTimeout(fn, ms),
+  wis: (h) => clearTimeout(h as ReturnType<typeof setTimeout>),
+};
+
+/** Het deel van WebSocket dat we gebruiken (de test geeft een nep). */
+export interface WsLike {
+  readyState: number;
+  send(data: string): void;
+  close(code?: number): void;
+  onopen: ((e?: unknown) => void) | null;
+  onmessage: ((e: { data: unknown }) => void) | null;
+  onerror: ((e?: unknown) => void) | null;
+  onclose: ((e?: { code?: number }) => void) | null;
+}
+export type WsKlasse = new (url: string) => WsLike;
+
+const klem = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
+/** Een volledig kanaalbericht van de APC: note-off, note-on of CC, precies 3 bytes, databytes 0..127. */
+const isApcBericht = (b: unknown): b is number[] =>
+  Array.isArray(b) && b.length === 3 && b.every((x) => Number.isInteger(x)) &&
+  [0x80, 0x90, 0xb0].includes(b[0] & 0xf0) && b[0] <= 0xbf && b[1] >= 0 && b[1] <= 127 && b[2] >= 0 && b[2] <= 127;
+/** Shift op de APC40 mkII: noot 98. */
+const SHIFT = 98;
+/** Loslaten (note-off, of note-on met 0) komt ook zonder focus door: dan blijft er nooit een knop hangen. */
+const isLos = (b: number[]) => (b[0] & 0xf0) === 0x80 || ((b[0] & 0xf0) === 0x90 && b[2] === 0);
+
+/** ademtempo (0..1) ↔ klok.adem_periode van de hub: 4 + 12·v seconden. AV-kern kent 4..14 s (Bus.breathCycle). */
+export const periodeNaarRate = (v: number) => klem(1 - (12 * klem(v)) / 10);
+export const rateNaarPeriode = (rate: number) => klem(((1 - rate) * 10) / 12);
+
+interface Koppel {
+  lees?: (bus: Bus) => number;
+  /** `tau` alleen bij een snapshot (dan glijdt alles, zoals een scène) */
+  zet?: (bus: Bus, v: number, tau?: number) => void;
+  trig?: (bus: Bus) => void;
+}
+/** Slew zoals op de APC zelf: macroknoppen en balans 'slew' (τ 1,5 s), master 'pick' (τ 0,15 s). Zie blueprint.ts. */
+const SLEW = 1.5, PICK = 0.15;
+/** Een hub-snapshot (LPD8 P5–P8, Bank + Scene) is als een scène: alles glijdt, ook master (regel 5). */
+export const SNAPSHOT_TAU = 2;
+const macro = (k: number): Koppel => ({ lees: (b) => b.tgt(`macro${k}`), zet: (b, v, tau = SLEW) => b.set(`macro${k}`, v, tau) });
+/** Per manifest-parameter: hoe hij de bus leest en zet. Alleen wat de APC ook mag. */
+export const KOPPEL: Record<string, Koppel> = {
+  master: { lees: (b) => b.tgt('master'), zet: (b, v, tau = PICK) => b.set('master', v, tau) },
+  kleur: macro(0), ruimte: macro(1), beweging: macro(2), dichtheid: macro(3),
+  korrel: macro(4), helderheid: macro(5), contrast: macro(6), adem: macro(7),
+  balans: { lees: (b) => b.tgt('xf'), zet: (b, v, tau = SLEW) => b.set('xf', v, tau) },
+  ademtempo: {
+    lees: (b) => rateNaarPeriode(b.breathRate),
+    zet: (b, v) => { b.breathRate = periodeNaarRate(v); b.touch('adem', `ademcyclus ${b.breathCycle().toFixed(1)} s (hub)`); },
+  },
+  // LPD8 P1 (1 s vasthouden): dezelfde Stop All als op de APC — alles langzaam naar stilte en zwart (regel 5).
+  paniek: { trig: (b) => b.stopAll() },
+};
+
+export interface HubStatus {
+  url: string;
+  verbonden: boolean;
+  focus: boolean;
+  vervangen: boolean;
+  /** SysEx die AV-kern wilde sturen en niet naar de hub ging */
+  ingeslikt: number;
+  /** LED-berichten naar de hub */
+  leds: number;
+  /** MIDI-berichten van de hub naar de driver */
+  midi: number;
+}
+
+export interface HubOpties {
+  url: string;
+  driver: Driver;
+  bus: Bus;
+  WS?: WsKlasse;
+  tijd?: Tijd;
+  inst?: string;
+  /** voor de statusregel bovenin */
+  onStatus?: (ok: boolean, tekst: string, s: HubStatus) => void;
+  /** bij elke invoer van de APC (main.ts: AudioContext hervatten, zoals bij Web MIDI) */
+  onInput?: () => void;
+}
+
+const nieuweInst = () => globalThis.crypto?.randomUUID?.() ?? `${Math.random()}`.slice(2);
+
+export class HubKoppeling {
+  readonly url: string;
+  private driver: Driver;
+  private bus: Bus;
+  private WS: WsKlasse;
+  private tijd: Tijd;
+  readonly inst: string;
+  private onStatus: NonNullable<HubOpties['onStatus']>;
+  private onInput: () => void;
+
+  private ws: WsLike | null = null;
+  private stap = 0;
+  focus = false;
+  vervangen = false;
+  ingeslikt = 0;
+  nLeds = 0;
+  nMidi = 0;
+  private gestopt = false;
+  /** Shift is via de hub ingedrukt (en nog niet losgelaten): alleen die laten we los als de hub wegvalt. */
+  private hubShift = false;
+  /** param-id → laatste waarde die de hub van ons kent */
+  private gezet = new Map<string, number>();
+  private leds: number[][] = [];
+  private ledTimer: unknown = null;
+  private tikTimer: unknown = null;
+  private herverbind: unknown = null;
+  private openTimer: unknown = null;
+  private stabielTimer: unknown = null;
+  private laatsteUit = -Infinity;
+
+  constructor(o: HubOpties) {
+    this.url = o.url;
+    this.driver = o.driver;
+    this.bus = o.bus;
+    this.WS = o.WS ?? (globalThis.WebSocket as unknown as WsKlasse);
+    this.tijd = o.tijd ?? echteTijd;
+    this.inst = o.inst ?? nieuweInst();
+    this.onStatus = o.onStatus ?? (() => {});
+    this.onInput = o.onInput ?? (() => {});
+    // De bestaande uitvoerhaak: alles wat de driver naar "de APC" stuurt, gaat naar de hub.
+    this.driver.onSend((b) => this.led(b));
+  }
+
+  start() {
+    this.tik();
+    this.verbind();
+    return this;
+  }
+
+  stop() {
+    this.gestopt = true;
+    for (const t of [this.tikTimer, this.herverbind, this.ledTimer, this.openTimer, this.stabielTimer]) if (t != null) this.tijd.wis(t);
+    const ws = this.ws;
+    this.ws = null;
+    try { ws?.close(); } catch { /* al dicht */ }
+  }
+
+  get open() { return this.ws?.readyState === 1; }
+
+  status(): HubStatus {
+    return { url: this.url, verbonden: this.open, focus: this.focus, vervangen: this.vervangen, ingeslikt: this.ingeslikt, leds: this.nLeds, midi: this.nMidi };
+  }
+
+  private meld() {
+    const s = this.status();
+    const tekst = s.vervangen ? 'Hub: een nieuwer AV-kern-tabblad heeft de hub: sluit dit tabblad'
+      : !s.verbonden ? `Hub niet bereikbaar (${this.url}): start de hub met \`npm start\` in AV-app-hub; AV-kern probeert het zelf opnieuw`
+      : s.focus ? 'APC via de hub · focus' : 'APC via de hub · geen focus (Bank + Track Select)';
+    this.onStatus(s.verbonden && !s.vervangen, tekst, s);
+  }
+
+  // ---- verbinding ------------------------------------------------------------------------------
+
+  private stuur(b: object) {
+    if (!this.open) return;
+    this.ws!.send(JSON.stringify(b));
+    this.laatsteUit = this.tijd.nu();
+  }
+
+  private verbind() {
+    if (this.gestopt) return;
+    let ws: WsLike;
+    try { ws = new this.WS(this.url); } catch { this.opnieuw(); return; }
+    this.ws = ws;
+    // Blijft hij hangen in CONNECTING (onbereikbare host): zelf opgeven, dan neemt opnieuw() het over.
+    this.openTimer = this.tijd.zet(() => {
+      if (this.ws !== ws || ws.readyState !== 0) return;
+      this.weg(ws, 1006);
+      try { ws.close(); } catch { /* al dicht */ }
+    }, OPEN_MS);
+    ws.onopen = () => {
+      if (this.ws !== ws) return;
+      this.tijd.wis(this.openTimer);
+      this.focus = false;
+      this.stuur({ t: 'hallo', app: APP, inst: this.inst, v: 1 });
+      this.stuur({ t: 'manifest', manifest: MANIFEST });
+      this.stuur({ t: 'staat', waarden: this.waarden() });
+      // De hub bewaart per app een LED-kaart: geef hem de hele set (ringtypes, LED's en ringen).
+      this.driver.resetLeds();
+      this.driver.sendRingTypes();
+      this.driver.computeLeds();
+      this.stabielTimer = this.tijd.zet(() => {
+        if (this.ws !== ws || !this.open) return;
+        this.stap = 0;
+        if (this.vervangen) { this.vervangen = false; this.meld(); }
+      }, STABIEL_MS);
+      this.meld();
+    };
+    ws.onmessage = (e) => { if (this.ws !== ws) return; this.bericht(e.data); this.hartslag(); };
+    ws.onerror = () => {};
+    ws.onclose = (e) => this.weg(ws, e?.code);
+  }
+
+  /** De verbinding is weg (door de hub, het netwerk, of door ons na OPEN_MS). */
+  private weg(ws: WsLike, code?: number) {
+    if (this.ws !== ws) return;
+    this.ws = null;
+    this.tijd.wis(this.openTimer);
+    this.tijd.wis(this.stabielTimer);
+    this.focus = false;
+    this.leds = [];
+    // Zoals bij een losgetrokken APC (midi.ts): Shift los, anders staat na terugkomen de Shift-laag nog vast.
+    // Alleen als die Shift van de hub kwam: een Shift van het toetsenbord of de virtuele APC blijft staan
+    // (ook bij elke mislukte herverbindpoging als de hub niet draait).
+    if (this.hubShift && this.driver.shiftHeld) this.driver.input([0x80, SHIFT, 0], 'hub');
+    this.hubShift = false;
+    if (code === VERVANGEN) this.vervangen = true;
+    this.meld();
+    this.opnieuw(code);
+  }
+
+  private opnieuw(code?: number) {
+    if (this.gestopt) return;
+    const ms = code === VERVANGEN ? VERVANGEN_MS : WACHT_MS[Math.min(this.stap++, WACHT_MS.length - 1)];
+    this.herverbind = this.tijd.zet(() => this.verbind(), ms);
+  }
+
+  // ---- van de hub ------------------------------------------------------------------------------
+
+  private bericht(tekst: unknown) {
+    let b: Record<string, unknown>;
+    try { b = JSON.parse(String(tekst)); } catch { return; }
+    if (!b || typeof b !== 'object') return;
+    if (b.t === 'midi') {
+      if (b.dev !== 'apc40' || !isApcBericht(b.bytes)) return;
+      const bytes = b.bytes;
+      if (!this.focus && !isLos(bytes)) return;
+      this.nMidi++;
+      this.onInput();
+      if (bytes[1] === SHIFT && (bytes[0] & 0xe0) === 0x80) this.hubShift = !isLos(bytes);
+      this.driver.input(bytes, 'hub');
+    } else if (b.t === 'focus') {
+      const aan = b.aan === true;
+      if (aan !== this.focus) { this.focus = aan; this.meld(); }
+      // Focus weg: niets uitzetten. Loslaten van wat nog ingedrukt is stuurt de hub ons toch.
+    } else if (b.t === 'zet') {
+      const id = String(b.id);
+      const k = KOPPEL[id];
+      if (!k?.zet || !k.lees || typeof b.v !== 'number' || !Number.isFinite(b.v)) return;
+      // Tijdens een replay van het actielog niets van buiten: dan blijft de replay identiek.
+      if (!this.driver.enabled) return;
+      const v = klem(b.v);
+      k.zet(this.bus, v, b.bron === 'snapshot' || b.bron === 'replay' ? SNAPSHOT_TAU : undefined);
+      // Wat de hub vroeg, niet wat AV-kern ervan maakte: wijkt dat af (ademtempo boven 14 s), dan meldt
+      // tik() de echte waarde terug. Gelijk = niet terugkaatsen.
+      this.gezet.set(id, v);
+    } else if (b.t === 'trig') {
+      // Paniek werkt bewust ook tijdens een replay: stilte en zwart gaan altijd voor.
+      const k = KOPPEL[String(b.id)];
+      if (k?.trig && b.aan === true) k.trig(this.bus);
+    } else if (b.t === 'fout') {
+      console.warn('[hub]', b.reden);
+      if (/^vervangen/.test(String(b.reden))) { this.vervangen = true; this.meld(); }
+    }
+    // welkom, globaal, scene en alles wat nog komt: negeren (PROTOCOL.md §1.5)
+  }
+
+  // ---- naar de hub -----------------------------------------------------------------------------
+
+  private waarden() {
+    const w: Record<string, number> = {};
+    for (const p of MANIFEST.params) {
+      const k = KOPPEL[p.id];
+      if (p.soort === 'trigger' || !k?.lees) continue;
+      w[p.id] = klem(k.lees(this.bus));
+      this.gezet.set(p.id, w[p.id]);
+    }
+    return w;
+  }
+
+  /** Elke TIK_MS: wat AV-kern zelf veranderde (APC, scène, muis) als `zet`, en de hartslag. */
+  private tik() {
+    if (this.gestopt) return;
+    if (this.open) {
+      for (const p of MANIFEST.params) {
+        const k = KOPPEL[p.id];
+        if (p.soort === 'trigger' || !k?.lees) continue;
+        const v = klem(k.lees(this.bus));
+        if (!Number.isFinite(v)) continue; // nooit null naar de hub
+        if (Math.abs(v - (this.gezet.get(p.id) ?? -1)) < 1e-4) continue;
+        this.gezet.set(p.id, v);
+        this.stuur({ t: 'zet', id: p.id, v });
+      }
+      this.hartslag();
+    }
+    this.tikTimer = this.tijd.zet(() => this.tik(), TIK_MS);
+  }
+
+  private hartslag() {
+    if (this.open && this.tijd.nu() - this.laatsteUit >= HB_MS) this.stuur({ t: 'hb' });
+  }
+
+  /** De uitvoerhaak van de driver: LED- en ringberichten, per beeld gebundeld. */
+  private led(bytes: number[]) {
+    if (this.gestopt) return;
+    if (bytes[0] === 0xf0) { this.ingeslikt++; return; } // modus-SysEx: alleen de hub zet de modus
+    if (!this.open) return; // bij (her)verbinden stuurt verbind() de hele set opnieuw
+    this.leds.push([...bytes]);
+    if (this.ledTimer != null) return;
+    this.ledTimer = this.tijd.zet(() => {
+      this.ledTimer = null;
+      if (this.leds.length) { this.nLeds += this.leds.length; this.stuur({ t: 'led', bytes: this.leds }); }
+      this.leds = [];
+    }, BEELD_MS);
+  }
+}
